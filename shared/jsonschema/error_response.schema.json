{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ErrorCode": {
      "enum": [
        "unauthorized",
        "unknown_account",
        "role_mismatch",
        "conversation_forbidden",
        "voice_profile_forbidden",
        "validation_error",
        "invalid_tool_result",
        "not_found",
        "proposal_mismatch",
        "proposal_not_pending",
        "idempotency_conflict",
        "payload_too_large",
        "unsupported_media_type",
        "audio_decode_error",
        "llm_unavailable",
        "llm_timeout",
        "stt_unavailable",
        "tts_unavailable",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "details": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorInfo"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
