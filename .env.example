# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ============================================================================
# Shared between the AI engine and the integration backend
# ============================================================================
# Service-to-service bearer token. The backend sends `Authorization: Bearer <key>`.
RABT_INTERNAL_API_KEY=replace-with-a-long-random-secret
# Where the integration backend reaches the AI engine.
RABT_AI_BASE_URL=http://127.0.0.1:8765

# ============================================================================
# AI engine (owner: Awaiz) - ai-engine/
# ============================================================================
RABT_HOST=127.0.0.1
RABT_PORT=8765
# Local data (SQLite memory, models, audio). Default: %USERPROFILE%\.rabt on Windows,
# ~/.local/share/rabt elsewhere. Keep it OUT of OneDrive/Dropbox-synced folders.
RABT_DATA_DIR=
RABT_DEFAULT_TIMEZONE=Asia/Dubai
RABT_LOG_LEVEL=INFO

# Local LLM (Ollama must listen on loopback/LAN only; hosted APIs are refused)
RABT_LLM_BASE_URL=http://127.0.0.1:11434
RABT_LLM_MODEL=qwen3.5:9b

# Conversation memory
RABT_RETENTION_DAYS=30

# ============================================================================
# Integration backend (owner: Huda) - add backend settings below.
# Keep OAuth client files and tokens outside the repo and reference them by path.
# ============================================================================
